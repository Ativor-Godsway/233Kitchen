# --- Database -------------------------------------------------------------
# MongoDB Atlas connection string. Leave EMPTY in local dev to use an
# in-memory MongoDB (auto-seeded, data kept in ./.data between restarts).
MONGODB_URI=

# --- Auth -----------------------------------------------------------------
# Long random string (e.g. `openssl rand -base64 48`). Required in production.
JWT_SECRET=
# Admin account created by `npm run seed` (and by the dev auto-seed).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email ----------------------------------------------------------------
# Leave RESEND_API_KEY empty in dev: emails are printed to the console and
# saved as HTML previews in ./.email-previews/.
RESEND_API_KEY=
EMAIL_FROM="+233 Kitchen <orders@yourdomain.com>"
# Optional reply-to for customer emails (e.g. the owner's Gmail).
EMAIL_REPLY_TO=
# Always receives a "new order" email (plus any extra addresses added in admin Settings).
OWNER_EMAIL=
# Provider switch: resend | smtp. If left empty, smtp is used whenever SMTP_USER + SMTP_PASS are set.
EMAIL_PROVIDER=smtp
# Gmail: SMTP_USER = your Gmail address, SMTP_PASS = a Gmail App Password
# (myaccount.google.com/apppasswords — needs 2-Step Verification). EMAIL_FROM must use the same address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- Site -----------------------------------------------------------------
SITE_URL=http://localhost:5173
TZ_BUSINESS=America/New_York
