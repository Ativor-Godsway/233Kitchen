# Copy to .env for local development. Never commit .env.
# In production (Vercel), set these in Project → Settings → Environment Variables (Production only).
# Production refuses to start if a required value is missing; see DEPLOY.md.

# --- Database (required in production) ------------------------------------
# MongoDB Atlas connection string. Leave EMPTY in local dev to use a local
# in-memory MongoDB (auto-seeded, data kept in ./.data between restarts).
MONGODB_URI=

# --- Auth (required in production) ----------------------------------------
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=

# --- Site (required in production) ----------------------------------------
# Public https URL, no trailing slash.
SITE_URL=http://localhost:5173
TZ_BUSINESS=America/New_York

# --- Email (required in production) ---------------------------------------
# Leave everything empty in local dev: emails are printed to the console and
# saved as HTML previews in ./.email-previews/ (never in production).
#
# Gmail (now): EMAIL_PROVIDER=gmail, SMTP_USER=<the Gmail address>,
#   SMTP_PASS=<16-character Gmail App Password>, EMAIL_FROM with the SAME address.
# Resend (later, own domain): EMAIL_PROVIDER=resend, RESEND_API_KEY=re_...,
#   EMAIL_FROM="+233 Kitchen <orders@your-domain>". Nothing else changes.
EMAIL_PROVIDER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# e.g. "+233 Kitchen <name@gmail.com>"
EMAIL_FROM=
# Receives every new-order email (more can be added in admin Settings). Also the
# Reply-To on customer emails unless EMAIL_REPLY_TO is set.
OWNER_EMAIL=
EMAIL_REPLY_TO=

# Optional marketing send limits (defaults shown; Gmail allows ~500 emails/day).
# EMAIL_DAILY_LIMIT=400
# EMAIL_BATCH_SIZE=50
# EMAIL_BATCH_DELAY_MS=5000

# --- Seeding only (optional) ----------------------------------------------
# Used by `npm run seed` to create the first admin. Prefer `npm run admin:set`,
# which asks for the password instead of storing it in a file.
ADMIN_EMAIL=
ADMIN_PASSWORD=
